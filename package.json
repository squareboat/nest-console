{
  "name": "@squareboat/nest-console",
  "version": "2.0.0",
  "description": "The console package for your NestJS Applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "cli.txt",
    "postinstall.js"
  ],
  "keywords": [
    "nestjs",
    "nestjs-console",
    "nestjs-cli",
    "nestjs-commander"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/squareboat/nest-console.git"
  },
  "bugs": {
    "url": "https://github.com/squareboat/nest-console/issues"
  },
  "homepage": "https://github.com/squareboat/nest-console",
  "author": "Squareboat <hi@squareboat.com>",
  "private": false,
  "license": "MIT",
  "scripts": {
    "postinstall": "node postinstall.js",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint 'lib/**/*.ts' --fix",
    "readme:npm": "mv README.md README.git.md && mv README.npm.md README.md",
    "readme:git": "mv README.md README.npm.md && mv README.git.md README.md",
    "prepublish:npm": "npm run readme:npm && npm run build",
    "publish:npm": "npm publish --access public",
    "postpublish:npm": "npm run readme:git",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "test:e2e": "jest --config ./tests/jest-e2e.json --runInBand",
    "test:e2e:dev": "jest --config ./tests/jest-e2e.json --runInBand --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@types/inquirer": "^8.2.13",
    "@types/node": "^20.19.43",
    "@types/yargs-parser": "^21.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "dependencies": {
    "app-root-path": "^3.1.0",
    "cli-table3": "^0.6.5",
    "inquirer": "^8.2.7",
    "ora": "^5.4.1",
    "picocolors": "^1.1.1",
    "yargs-parser": "^21.1.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
